# Copy to .env and fill in. Never commit .env. Everything here is optional:
# with no key the app runs on FakeLLM.

# --- LLM ---
LLM_PROVIDER=groq                 # groq | fake  (Gemini: documented swap point, not implemented)
GROQ_API_KEY=                     # from console.groq.com (leave empty for FakeLLM)
LLM_MODEL=openai/gpt-oss-20b      # checked 2026-11-20: Llama models return 404 on the free tier
LLM_TIMEOUT_S=2.2
LLM_MAX_TOKENS=300                # includes gpt-oss hidden reasoning tokens
LLM_REASONING_EFFORT=low          # low | medium | high

# --- Auth ---
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ISSUER=commute-policy-mock-issuer
JWT_AUDIENCE=commute-policy-api
JWT_TTL_S=900
DEV_MODE=false                    # true enables /dev/token. NEVER true in production.

# --- Storage ---
DATA_DIR=./var

# --- Retrieval / answering ---
RETRIEVAL_K=3                     # 1..3; max 3 cited chunks per answer
RETRIEVAL_MODE=vector             # vector | hybrid
NOT_COVERED_MIN_SIM=0.15          # pre-filter only; chosen on the DEV split in P4 (docs/DESIGN_DECISIONS.md D52)
RETRIEVAL_TIMEOUT_S=0.5
REQUEST_TIMEOUT_S=2.8
MAX_QUESTION_CHARS=500
